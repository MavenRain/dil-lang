-- The dil-lang domain in use: a key, an event, a state and its cost.
def seats : Key := key "seats"
def order : Event := event seats (vNat 2)
def cart : State := setT seats order nil
def cartSeats : Value := getOr seats (vNat 0) cart
def seatCount : Nat := fold (fun (n : Nat) => n) (fun (f : Flag) => 0) (fun (t : Str) => 0) cartSeats
def cost : Nat := natMul seatCount 29
