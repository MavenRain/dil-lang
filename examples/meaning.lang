-- Guest tests of the meaning operations (slice D2), one group for each rule
-- of design/DESIGN.md lines 31 to 62. A test with parameters holds for each
-- phrase, state and event (refl); a closed instance also runs in the JS selftest.
def kSeats : Key := key "seats"
def kOpen : Key := key "open"
def start : State := cons (pair kSeats (vNat 2)) nil
def bump : Event := event kSeats (vNat 3)
def flip : Event := event kOpen (vFlag flagYes)
def natOf : (v : Value) -> Nat := fun (v : Value) => fold (fun (n : Nat) => n) (fun (f : Flag) => 0) (fun (t : Str) => 0) v
def flagOf : (v : Value) -> Flag := fun (v : Value) => fold (fun (n : Nat) => flagNo) (fun (f : Flag) => f) (fun (t : Str) => flagNo) v
-- const price = seats * 29 (line 56).
def price : Expr := lift1 (fun (v : Value) => vNat (natMul (natOf v) 29)) (cell kSeats (vNat 1))
def isOpen : (s : State) -> Flag := fun (s : State) => flagOf (getOr kOpen (vFlag flagNo) s)
def rows : (s : State) -> List Value := fun (s : State) => cons (vNat 1) (cons (vText "a") nil)
def sliderOf : (k : Key) -> Meaning := fun (k : Key) => component (name "Slider") (cons (pair (name "value") (cell k (vNat 1))) nil) (cons (setter k) nil) omitted

-- Static text (line 33): a constant view and the identity transition.
def textView : (t : Str) -> (s : State) -> Eq UITree (viewOf (staticText t) s) (text t tEnd) := fun (t : Str) (s : State) => refl
def textStep : (t : Str) -> (e : Event) -> (s : State) -> Eq State (transOf (staticText t) e s) s := fun (t : Str) (e : Event) (s : State) => refl
def textAt : Eq UITree (viewOf (staticText "Seats") start) (text "Seats" tEnd) := refl
-- Interpolation (line 39): the view shows eval(e, s); the identity transition.
def interpView : (x : Expr) -> (s : State) -> Eq UITree (viewOf (interpolate x) s) (text (showValue (x s)) tEnd) := fun (x : Expr) (s : State) => refl
def interpStep : (x : Expr) -> (e : Event) -> (s : State) -> Eq State (transOf (interpolate x) e s) s := fun (x : Expr) (e : Event) (s : State) => refl
def interpAt : Eq UITree (viewOf (interpolate price) start) (text "58" tEnd) := refl
-- Component tag (line 46): props and kids pointwise; the handlers, then the
-- transition of the kids.
def tagView : (c : Name) -> (ps : List (Prod Name Expr)) -> (hs : List Trans) -> (kids : Meaning) -> (s : State) -> Eq UITree (viewOf (component c ps hs kids) s) (comp c (map (fun (p : Prod Name Expr) => pair (first p) (second p s)) ps) (viewOf kids s) tEnd) := fun (c : Name) (ps : List (Prod Name Expr)) (hs : List Trans) (kids : Meaning) (s : State) => refl
def tagStep : (c : Name) -> (ps : List (Prod Name Expr)) -> (hs : List Trans) -> (kids : Meaning) -> (e : Event) -> (s : State) -> Eq State (transOf (component c ps hs kids) e s) (thenT (thenAll hs) (transOf kids) e s) := fun (c : Name) (ps : List (Prod Name Expr)) (hs : List Trans) (kids : Meaning) (e : Event) (s : State) => refl
def tagAt : Eq UITree (viewOf (sliderOf kSeats) start) (comp (name "Slider") (cons (pair (name "value") (vNat 2)) nil) tEnd tEnd) := refl
def tagStepAt : Eq State (transOf (sliderOf kSeats) bump start) (cons (pair kSeats (vNat 3)) nil) := refl
-- State declaration (line 51): the remainder runs in the extended state, and
-- the setter writes payload(e) to its cell.
def declFresh : Eq UITree (viewOf (useState kOpen (vFlag flagNo) (interpolate (cell kOpen (vFlag flagYes)))) start) (text "false" tEnd) := refl
def declKept : Eq UITree (viewOf (useState kSeats (vNat 0) (interpolate (cell kSeats (vNat 1)))) start) (text "2" tEnd) := refl
def declStep : Eq State (transOf (useState kOpen (vFlag flagNo) (sliderOf kSeats)) bump start) (cons (pair kSeats (vNat 3)) (cons (pair kOpen (vFlag flagNo)) nil)) := refl
def setterHit : Eq State (setter kSeats bump start) (cons (pair kSeats (vNat 3)) nil) := refl
def setterMiss : Eq State (setter kSeats flip start) start := refl
-- A derived binding (line 56) is a pure function of the current state.
def deriveView : (x : Expr) -> (body : Value -> Meaning) -> (s : State) -> Eq UITree (viewOf (derive x body) s) (viewOf (body (x s)) s) := fun (x : Expr) (body : Value -> Meaning) (s : State) => refl
def deriveAt : Eq UITree (viewOf (derive price (fun (v : Value) => staticText (showValue v))) start) (text "58" tEnd) := refl
-- Conditionals and loops (line 59): the selected branch; the body under each binding.
def condYes : (a : Meaning) -> (b : Meaning) -> (s : State) -> Eq UITree (viewOf (conditional (fun (u : State) => flagYes) a b) s) (viewOf a s) := fun (a : Meaning) (b : Meaning) (s : State) => refl
def condNoStep : (a : Meaning) -> (b : Meaning) -> (e : Event) -> (s : State) -> Eq State (transOf (conditional (fun (u : State) => flagNo) a b) e s) (transOf b e s) := fun (a : Meaning) (b : Meaning) (e : Event) (s : State) => refl
def condAt : Eq UITree (viewOf (conditional isOpen (staticText "open") (staticText "closed")) start) (text "closed" tEnd) := refl
def loopNone : (body : Value -> Meaning) -> (s : State) -> Eq UITree (viewOf (loopOver (fun (u : State) => nil) body) s) tEnd := fun (body : Value -> Meaning) (s : State) => refl
def loopView : Eq UITree (viewOf (loopOver rows (fun (v : Value) => interpolate (lit v))) start) (text "1" (text "a" tEnd)) := refl
def loopStep : Eq State (transOf (loopOver rows (fun (v : Value) => (sliderOf kSeats))) bump start) (cons (pair kSeats (vNat 3)) nil) := refl
-- Event handlers (line 61) change the transition, never the view.
def handlerView : (c : Name) -> (ps : List (Prod Name Expr)) -> (hs : List Trans) -> (kids : Meaning) -> (s : State) -> Eq UITree (viewOf (component c ps hs kids) s) (viewOf (component c ps nil kids) s) := fun (c : Name) (ps : List (Prod Name Expr)) (hs : List Trans) (kids : Meaning) (s : State) => refl
def handlerAt : Eq State (transOf (component (name "Button") nil (cons (setter kOpen) nil) omitted) flip start) (cons (pair kSeats (vNat 2)) (cons (pair kOpen (vFlag flagYes)) nil)) := refl
